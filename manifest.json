{
  "manifest_version": 3,
  "name": "Intentional YT",
  "short_name": "Intentional YT",
  "version": "2.1.0",
  "description": "Distraction-free YouTube with granular controls for feeds, Shorts, comments, and watch time limits. 100% private & local.",
  "browser_specific_settings": {
    "gecko": {
      "id": "intentional-yt@intentional-yt.local",
      "strict_min_version": "121.0"
    }
  },

  "permissions": [
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "exclude_matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "utils/storage.js",
        "content/blocker.js",
        "content/timerToast.js",
        "content/youtubeObserver.js"
      ],
      "css": [
        "styles/blocker.css"
      ],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Intentional YT",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "styles/blocker.css"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ]
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

