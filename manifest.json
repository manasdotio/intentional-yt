{
  "manifest_version": 2,
  "name": "Intentional YT",
  "short_name": "Intentional YT",
  "version": "2.0.0",
  "description": "A lean, silent, non-blocking distraction-reduction companion for YouTube.",
  "browser_specific_settings": {
    "gecko": {
      "id": "intentional-yt@intentional-yt.local",
      "strict_min_version": "109.0"
    }
  },
  
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "*://www.youtube.com/*",
    "*://youtube.com/*"
  ],

  "background": {
    "scripts": [
      "utils/storage.js",
      "background/background.js"
    ],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "exclude_matches": ["*://music.youtube.com/*"],
      "js": [
        "utils/storage.js",
        "content/blocker.js",
        "content/timerToast.js",
        "content/youtubeObserver.js"
      ],
      "css": [
        "styles/blocker.css"
      ],
      "run_at": "document_start"
    }
  ],

  "browser_action": {
    "default_popup": "ui/popup.html",
    "default_title": "Intentional YT",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },

  "web_accessible_resources": [
    "styles/blocker.css"
  ],

  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}