{
  "manifest_version": 2,
  "name": "Intentional YT",
  "short_name": "Intentional YT",
  "version": "2.0.0",
  "description": "The best YouTube distraction-removal extension. Granular controls, watch time tracking, channel & keyword blocklists. Zero tracking, all local.",
  "browser_specific_settings": {
    "gecko": {
      "id": "intentional-yt@intentional-yt.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "storage",
    "alarms",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*"
  ],

  "background": {
    "scripts": [
      "utils/storage.js",
      "background/background.js"
    ],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "exclude_matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "utils/storage.js",
        "content/blocker.js",
        "content/timerToast.js",
        "content/youtubeObserver.js"
      ],
      "css": [
        "styles/blocker.css"
      ],
      "run_at": "document_start"
    }
  ],

  "browser_action": {
    "default_popup": "ui/popup.html",
    "default_title": "Intentional YT",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "web_accessible_resources": [
    "styles/blocker.css"
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
