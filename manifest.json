{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "2.1.2",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "intentional-yt@intentional-yt.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*"
  ],

  "background": {
    "service_worker": "background/background.js",
    "scripts": [
      "utils/storage.js",
      "background/background.js"
    ]
  },

  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "exclude_matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "utils/storage.js",
        "utils/i18n.js",
        "content/blocker.js",
        "content/timerToast.js",
        "content/youtubeObserver.js"
      ],
      "css": [
        "styles/blocker.css"
      ],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Intentional YT",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "styles/blocker.css",
        "_locales/*/*.json"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ]
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

